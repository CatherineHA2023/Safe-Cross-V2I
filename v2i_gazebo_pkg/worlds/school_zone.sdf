            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>-1.088 38.0893 0 1.5707 -0 0</pose>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>
    <model name='tree-large_2'>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>file:///home/jihyunlee/v2i_ws/src/Safe-Cross-V2I/v2i_gazebo_pkg/models/kenney_city-kit-suburban_20/city_kit/OBJ format/tree-large.obj</uri>
              <scale>10 10 10</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>file:///home/jihyunlee/v2i_ws/src/Safe-Cross-V2I/v2i_gazebo_pkg/models/kenney_city-kit-suburban_20/city_kit/OBJ format/tree-large.obj</uri>
              <scale>10 10 10</scale>
            </mesh>
          </geometry>
        </collision>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0.6094 -37.3703 -0.001576 1.5707 -0 0</pose>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>
    <model name='yellow_crosswalk'>
      <static>true</static>
      <pose>0 0 0.1 0 -0 0</pose>
      <link name='link'>
        <visual name='stripe_2'>
          <pose>-1.2 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
        <visual name='stripe_3'>
          <pose>-1.5 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
        <visual name='stripe_4'>
          <pose>-1.8 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
        <visual name='stripe_5'>
          <pose>-0.9 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
        <visual name='stripe_6'>
          <pose>-0.6 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <self_collide>false</self_collide>
    </model>
    <light name='sun' type='directional'>
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.5 -0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ===== 차단기 로봇 1 (횡단보도 +Y 끝, y=3.0) ===== -->
    <!-- 기둥이 바의 +Y 끝(y=3.0)에 위치, 바가 -Y 방향(안쪽)으로 3m 뻗음 -->
    <!-- ===== 인프라 고정 카메라 (횡단보도 감시) ===== -->
    <model name='infrastructure_camera'>
      <static>true</static>
      <pose>3.0 0.0 3.0 0 0 0</pose>
      <link name='body'>
        <visual name='pole'>
          <pose>0 0 -1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
        <visual name='cam_box'>
          <geometry><box><size>0.15 0.15 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        <sensor name='v2i_camera' type='camera'>
          <pose>0 0 0.2 0 1.01 3.1416</pose>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>50</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- angle=0   : 바가 Y방향(도로와 평행) → 보행자 차단              -->
    <!-- angle=1.57: Z축 90도 회전 → 바가 X방향(도로에 수직) → 차량 차단 -->
    <model name='crosswalk_barricade'>
      <pose>0.5 -3.0 0 0 0 0</pose>

      <!-- 기둥: 회색 수직 막대 + 넓은 받침대 (5000kg, 넘어지지 않음) -->
      <link name='base'>
        <pose>0 0 0.5 0 0 0</pose>
        <inertial>
          <mass>5000</mass>
          <inertia>
            <ixx>10417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>10417</iyy><iyz>0</iyz><izz>20833</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.1 0.1 1.0</size></box></geometry>
        </collision>
        <!-- 보이지 않는 넓은 받침대 (물리 안정용) -->
        <collision name='base_plate'>
          <pose>0 0 -0.45 0 0 0</pose>
          <geometry><box><size>1.0 1.0 0.1</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.1 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 차단바: 기둥(pivot)에서 +Y 방향으로 4.5m 뻗음 -->
      <link name='bar'>
        <pose>0 0 1.0 0 0 0</pose>
        <inertial>
          <pose>0 2.25 0 0 0 0</pose>
          <mass>2</mass>
          <inertia>
            <ixx>3.376</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001</iyy><iyz>0</iyz><izz>3.376</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <pose>0 2.25 0 0 0 0</pose>
          <geometry><box><size>0.08 4.5 0.08</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 2.25 0 0 0 0</pose>
          <geometry><box><size>0.08 4.5 0.08</size></box></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Z축 회전 조인트: 수평면에서 회전 -->
      <joint name='bar_joint' type='revolute'>
        <parent>base</parent>
        <child>bar</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>
          </limit>
          <dynamics>
            <damping>0.1</damping>
          </dynamics>
        </axis>
      </joint>

      <!-- JointPositionController: /barricade/joint_angle 토픽 수신 -->
      <!-- 브릿지: /barricade/joint_angle@std_msgs/msg/Float64]ignition.msgs.Double -->
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>bar_joint</joint_name>
        <topic>/barricade/joint_angle</topic>
        <p_gain>30000</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>1200.0</d_gain>
        <i_max>10</i_max>
        <i_min>-10</i_min>
        <cmd_max>50000</cmd_max>
        <cmd_min>-50000</cmd_min>
      </plugin>
    </model>

    <!-- ===== 차단기 로봇 2 (횡단보도 -Y 끝, y=-3.0) ===== -->
    <!-- 기둥이 바의 -Y 끝(y=-3.0)에 위치, 바가 +Y 방향(안쪽)으로 3m 뻗음 -->
    <!-- 같은 /barricade/joint_angle 토픽 구독 → 두 차단기 동시 제어       -->
    <model name='crosswalk_barricade_2'>
      <pose>-2.5 -3.0 0 0 0 0</pose>

      <!-- 기둥: 회색 수직 막대 + 넓은 받침대 (5000kg, 넘어지지 않음) -->
      <link name='base'>
        <pose>0 0 0.5 0 0 0</pose>
        <inertial>
          <mass>5000</mass>
          <inertia>
            <ixx>10417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>10417</iyy><iyz>0</iyz><izz>20833</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.1 0.1 1.0</size></box></geometry>
        </collision>
        <!-- 보이지 않는 넓은 받침대 (물리 안정용) -->
        <collision name='base_plate'>
          <pose>0 0 -0.45 0 0 0</pose>
          <geometry><box><size>1.0 1.0 0.1</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.1 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 차단바: 기둥(pivot)에서 +Y 방향으로 4.5m 뻗음 -->
      <link name='bar'>
        <pose>0 0 1.2 0 0 0</pose>
        <inertial>
          <pose>0 2.25 0 0 0 0</pose>
          <mass>2</mass>
          <inertia>
            <ixx>3.376</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001</iyy><iyz>0</iyz><izz>3.376</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <pose>0 2.25 0 0 0 0</pose>
          <geometry><box><size>0.08 4.5 0.08</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 2.25 0 0 0 0</pose>
          <geometry><box><size>0.08 4.5 0.08</size></box></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Z축 회전 조인트 (반대 방향: -Z축 기준 회전 → 같은 명령에 반대로 열림) -->
      <joint name='bar_joint' type='revolute'>
        <parent>base</parent>
        <child>bar</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>
          </limit>
          <dynamics>
            <damping>0.1</damping>
          </dynamics>
        </axis>
      </joint>

      <!-- 같은 토픽 → 두 차단기 동시 제어 -->
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>bar_joint</joint_name>
        <topic>/barricade/joint_angle</topic>
        <p_gain>30000</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>1200.0</d_gain>
        <i_max>10</i_max>
        <i_min>-10</i_min>
        <cmd_max>50000</cmd_max>
        <cmd_min>-50000</cmd_min>
      </plugin>
    </model>

  </world>
</sdf>
